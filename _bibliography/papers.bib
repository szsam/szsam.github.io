@inproceedings{shen2026democratizing,
  abbr        = {RAID},
  bibtex_show = {true},
  selected    = {true},
  title       = {Democratizing False Positives Filtering Through Learning Assisted Reasoning},
  author      = {Shen, Mingjie and Tanksalkar, Sai Ritvik and Hauser, Christophe and Machiry, Aravind},
  editor      = {Bao, T. and Kemerlis, V. P. and Meng, W.},
  booktitle   = {Research in Attacks, Intrusions, and Defenses (RAID 2026)},
  series      = {Lecture Notes in Computer Science},
  volume      = {17161},
  pages       = {3--32},
  publisher   = {Springer},
  address     = {Cham},
  year        = {2027},
  doi         = {10.1007/978-3-032-42929-2_1},
  pdf         = {shen2026democratizing.pdf},
  abstract    = {Static Application Security Testing (SAST) tools report many false positives, and LLMs struggle to triage alerts on large codebases because of limited context. We present Aithos, an LLM-agent framework that gathers program context on demand through analysis primitives and learns repository-specific examples from developer feedback. On real-world C/C++ projects, Aithos preserves 97.5% of true positives (vs. 57.9% for a state-of-the-art baseline) while filtering 78.0% of false positives, and it uncovered 90 previously unknown bugs in 28 popular Debian packages.}
}

@article{shen2025codeql,
  abbr        = {ISSTA},
  bibtex_show = {true},
  selected    = {true},
  author      = {Mingjie Shen and
                 Akul Abhilash Pillai and
                 Brian A. Yuan and
                 James C. Davis and
                 Aravind Machiry},
  title       = {Finding 709 Defects in 258 Projects: An Experience Report on Applying
                 CodeQL to Open-Source Embedded Software (Experience Paper)},
  journal     = {Proc. {ACM} Softw. Eng.},
  volume      = {2},
  number      = {{ISSTA}},
  pages       = {1077--1100},
  year        = {2025},
  doi         = {10.1145/3728923},
  arxiv       = {2310.00205},
  abstract    = {We study the use of SAST tools in 258 popular Open-Source Embedded Software (EMBOSS) projects. Through program analysis and a developer survey, we find that only 3% of projects use advanced SAST tools. Applying CodeQL to these projects revealed 709 true defects at a 34% false positive rate; developers have confirmed 376 of them, two CVEs were issued, and 37 projects adopted our CodeQL workflows in their CI pipelines.}
}

@inproceedings{hashmat2024insights,
  abbr        = {ICISS},
  bibtex_show = {true},
  selected    = {true},
  author      = {Fabiha Hashmat and
                 Zeyad Alwaleed Aljaali and
                 Mingjie Shen and
                 Aravind Machiry},
  title       = {Insights from Running 24 Static Analysis Tools on Open Source Software Repositories},
  booktitle   = {International Conference on Information Systems Security (ICISS 2024)},
  series      = {Lecture Notes in Computer Science},
  volume      = {15416},
  pages       = {225--245},
  publisher   = {Springer},
  year        = {2024},
  doi         = {10.1007/978-3-031-80020-7_13},
  pdf         = {https://purs3lab.github.io/files/sastiss.pdf},
  abstract    = {We present the first comprehensive study of 24 open-source static analysis tools, run through Omega Analyzer on 4,947 critical open-source repositories. We examine how easily the tools run on these repositories, what issues they find, and how accurate those issues are, offering insights into their effectiveness and directions for securing open-source software.}
}

@inproceedings{shen2023layering,
  abbr        = {LCTES},
  bibtex_show = {true},
  selected    = {true},
  author      = {Mingjie Shen and
                 James C. Davis and
                 Aravind Machiry},
  editor      = {Bernhard Egger and
                 Dongyoon Lee},
  title       = {Towards Automated Identification of Layering Violations in Embedded
                 Applications {(WIP)}},
  booktitle   = {Languages, Compilers, and Tools for Embedded Systems (LCTES 2023)},
  pages       = {143--147},
  publisher   = {{ACM}},
  year        = {2023},
  doi         = {10.1145/3589610.3596271},
  code        = {https://github.com/RTOSExploration/lctes2023-artifact},
  abstract    = {Embedded software follows a layered design for portability. We detect a class of layering violations, Non Conventional MMIO Accesses (NCMAs), where applications access memory-mapped I/O directly instead of through the Hardware Abstraction Layer. On a new dataset of 988 compilable applications spanning 5 RTOSes, our tool identified 369 NCMAs, which we reported to developers.}
}
